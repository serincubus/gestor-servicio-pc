<%- include('./partials/head.ejs') %>
<%- include('./partials/header.ejs') %>
<!-- Vinculamos las hojas de estilos externas -->
<link rel='stylesheet' href='/stylesheets/style.css' />
<link rel='stylesheet' href='/stylesheets/formCliente.css' />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body>
  <div class="container">
    <h1><%= title %></h1>

    <!-- SECCIÓN DE ACCIONES: BOTONES DE CONTROL SUPERIORES -->
            <!-- CONTAINER CENTRAL DEL DASHBOARD MODERNO -->
        <div class="dashboard-grid-container">

            <!-- TARJETA EXCLUSIVA: CONTROL DE SUSCRIPCIONES SAAS (SOLO VISIBLE PARA EL SUPER ADMIN) -->
            <% if (typeof usuarioSesion !== 'undefined' && usuarioSesion && usuarioSesion.rol === 'superadmin') { %>
              <a href="/saas/panel" class="card-dashboard" style="background: linear-gradient(135deg, #d69e2e, #b7791f);">
                <div class="card-icon-wrapper">
                  <span class="card-icon">👑</span>
                </div>
                <div class="card-content">
                   <h3>Consola Maestra SaaS</h3>
                    <p>Administrar locales suscritos, cuotas mensuales y control de licencias globales.</p>
                </div>
                <div class="card-arrow">〉</div>
              </a>
            <% } %>
 
            
            <!-- TARJETA 1: REGISTRAR NUEVO INGRESO (AZUL) -->
            <!-- Importante: Le asignamos el ID "btn-toggle-registro" para que el script del Drawer se ejecute al hacerle clic -->
            <div class="card-dashboard card-azul" id="btn-toggle-registro">
                <div class="card-icon-wrapper">
                    <span class="card-icon">＋</span>
                </div>
                <div class="card-content">
                    <h3>Registrar Nuevo Ingreso</h3>
                    <p>Cargar un nuevo equipo o servicio técnico.</p>
                </div>
                <div class="card-arrow">〉</div>
            </div>

            <!-- TARJETA 2: VER HISTORIAL Y REPORTES (VERDE) -->
            <% if (typeof usuarioSesion !== 'undefined' && usuarioSesion.rol === 'admin') { %>
                <a href="/historial" class="card-dashboard card-verde">
                    <div class="card-icon-wrapper">
                        <span class="card-icon">📊</span>
                    </div>
                    <div class="card-content">
                        <h3>Ver Historial y Reporte de Pagos</h3>
                        <p>Consultar ingresos anteriores y pagos realizados.</p>
                    </div>
                    <div class="card-arrow">〉</div>
                </a>
            <% } else { %>
                <!-- Versión deshabilitada visualmente si es técnico menor -->
                <div class="card-dashboard card-deshabilitada">
                    <div class="card-icon-wrapper">
                        <span class="card-icon">📊</span>
                    </div>
                    <div class="card-content">
                        <h3>Ver Historial y Reporte de Pagos</h3>
                        <p>Acceso restringido para personal técnico.</p>
                    </div>
                </div>
            <% } %>

            <!-- TARJETA 3: CATÁLOGO Y STOCK (VIOLETA) -->
            <a href="/hardware" class="card-dashboard card-violeta">
                <div class="card-icon-wrapper">
                    <span class="card-icon">💻</span>
                </div>
                <div class="card-content">
                    <h3>Catálogo y Stock de Hardware</h3>
                    <p>Gestiona tu inventario de productos y repuestos.</p>
                </div>
                <div class="card-arrow">〉</div>
            </a>

            <!-- TARJETA 4: CONTROL DE TÉCNICOS (CELESTE - PROTEGIDA POR ROL) -->
                <% if (typeof usuarioSesion !== 'undefined' && usuarioSesion && usuarioSesion.rol === 'admin') { %>
                    <a href="/users/management" class="card-dashboard card-celeste">
                        <div class="card-icon-wrapper">
                            <span class="card-icon">👥</span>
                        </div>
                        <div class="card-content">
                            <h3>Control de Técnicos</h3>
                            <p>Administra técnicos, permisos y asignaciones del personal.</p>
                        </div>
                        <div class="card-arrow">〉</div>
                    </a>
                <% } %>

        </div>


      <!-- Fondo oscuro semitransparente de respaldo para el Drawer de Ingresos -->
  <div id="drawer-overlay-ingreso" class="drawer-overlay"></div>

  <!-- 📑 NUEVO DRAWER INTERACTIVO: FORMULARIO DE NUEVO INGRESO -->
  <div class="bloque-formulario hardware-drawer" id="drawer-nuevo-ingreso">
    <div class="drawer-header">
        <h3 id="titulo-drawer-ingreso">📋 Registrar Nuevo Ingreso</h3>
        <button type="button" class="btn-cerrar-drawer" id="btn-cerrar-drawer-ingreso">✕</button>
    </div>
    
    <!-- ➕ CONTENEDOR ENVOLVENTE CON EL ID QUE BUSCA TU SCRIPT -->
<div id="contenedor-formulario-registro" style="margin-top: 15px; background: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    
    <form action="/guardar" method="POST" class="form-usuarios-input" id="form-registro-principal" style="display: flex !important; flex-direction: column !important; padding: 10px 20px;">
        
        <!-- Input oculto para atrapar el ID del cliente del historial -->
        <input type="hidden" name="id_cliente" id="input-id-cliente-oculto" value="">

        <label><strong>Nombre del Cliente:</strong></label>
        <input type="text" name="nombre" id="input-nombre" placeholder="Ej: Carlos Pérez" required style="width:100%; padding:10px; margin-bottom:15px; border:1px solid #cbd5e0; border-radius:4px;">
        
        <label><strong>Teléfono / WhatsApp:</strong></label>
        <input type="text" name="telefono" id="input-telefono" placeholder="Ej: 1123456789" required style="width:100%; padding:10px; margin-bottom:15px; border:1px solid #cbd5e0; border-radius:4px;">
        
        <label><strong><%= labels.labelElemento %>:</strong></label>
        <input type="text" name="equipo" id="input-equipo" placeholder="<%= labels.placeholderElemento %>" required style="width:100%; padding:10px; margin-bottom:15px; border:1px solid #cbd5e0; border-radius:4px;">
        
        <label><strong><%= labels.labelFalla %>:</strong></label>
        <textarea name="falla" id="input-falla" placeholder="Describa el problema..." required style="width:100%; padding:10px; margin-bottom:15px; border:1px solid #cbd5e0; border-radius:4px; height: 80px; resize: none; font-family:inherit;"></textarea>
        
        <label><strong>Estado Inicial:</strong></label>
        <select name="estado" style="width:100%; padding:10px; margin-bottom:20px; border:1px solid #cbd5e0; border-radius:4px; font-size:15px;">
            <option value="Ingresado">📥 Ingresado</option>
            <option value="En Reparación">🛠️ En Reparación</option>
        </select>

        <button type="submit" class="btn-guardar" style="width:100%; padding: 12px; font-size: 15px;">
            💾 Guardar Ficha e Ingresar
        </button>
    </form>
</div>
</div>



    <hr class="separador-seccion">

    <!-- BARRA DE BÚSQUEDA INTEGRADA -->
    <form action="/" method="GET" class="form-busqueda">
        <input type="text" name="q" placeholder="🔍 Buscar cliente por nombre..." class="input-busqueda" required>
        <button type="submit" class="btn-buscar">Buscar</button>
        <a href="/" class="btn-link-cancelar">Limpiar</a>
    </form>

    <!-- LISTADO GENERAL DE TARJETAS DE REPARACIÓN -->
    <h2><%= labels.tituloGrilla %></h2>
   <div id="lista-reparaciones">
  <% if (lista && lista.length > 0) { %>
    <% lista.forEach(ticket => { %> <!-- 🛠️ Cambiamos 'cliente' por 'ticket' para evitar confusiones de variables -->
      <div class="reparacion-card">
        <!-- 🧠 Validamos si los datos del cliente vienen sueltos o anidados por el Join relacional -->
        <% 
           let idCliente = ticket.id_cliente || (ticket.cliente ? ticket.cliente.id_cliente : '');
           let nombreCliente = ticket.nombre || (ticket.cliente ? ticket.cliente.nombre : 'Cliente Sin Nombre');
           let telefonoCliente = ticket.telefono || (ticket.cliente ? ticket.cliente.telefono : '');
           let idMecanismoEliminar = ticket.id_ticket || ticket.id_usuario || idCliente;
        %>

        <strong class="txt-cliente"><%= nombreCliente %></strong> - <span class="txt-equipo"><%= ticket.equipo %></span>
        <p class="txt-falla">Falla: <%= ticket.falla %></p>
        
        <!-- CONTENEDOR CONTROLLER FLEXBOX PRINCIPAL -->
        <div class="contenedor-acciones-flex">
            
            <!-- Grupo Izquierdo: Operaciones de Gestión -->
            <div class="grupo-operaciones-izquierda">
                <a href="/detalle/<%= idCliente %>" class="btn-ux btn-ux-detalle">
                    🔍 Ver Detalle
                </a>
                <a href="/editar/<%= idCliente %>" class="btn-ux btn-ux-editar">
                    ✏️ Editar
                </a>
                
                <!-- 🛠️ BOTÓN CORREGIDO: Pasa los datos sanitizados libres de errores 'undefined' -->
                <button type="button" class="btn-ux btn-ux-nuevo" onclick="prepararNuevoTicket('<%= idCliente %>', '<%= nombreCliente %>', '<%= telefonoCliente %>')">
                    ➕ Nuevo Ticket
                </button>
            </div>

            <!-- Grupo Derecho: Seguridad / Eliminación -->
            <div class="grupo-seguridad-derecha">
                <button type="button" class="btn-eliminar-flex" onclick="confirmarEliminacion('<%= idMecanismoEliminar %>')">
                    🗑️ Eliminar Ticket
                </button>
                <!-- FORMULARIO OCULTO PARA EL POST REAL -->
                <form id="form-eliminar-<%= idMecanismoEliminar %>" action="/eliminar/<%= idMecanismoEliminar %>" method="POST" style="display: none;"></form>
            </div>
            
        </div>

        <div class="contenedor-estado">
            <small class="badge-estado-inicio">Estado: <%= ticket.estado %></small>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p class="txt-sin-registros">No hay equipos registrados todavía.</p>
  <% } %>
</div>


  <!-- CONTROL DE INTERFAZ Y COMPORTAMIENTO SCRIPT -->
 <script>
    // ⚙️ MANEJO DE DESPLIEGUE MODULAR (DRAWER LATERAL)
    function abrirDrawerIngreso() {
        const drawer = document.getElementById('drawer-nuevo-ingreso');
        const overlay = document.getElementById('drawer-overlay-ingreso');
        if (drawer && overlay) {
            drawer.classList.add('open');
            overlay.classList.add('open');
        }
    }

    function cerrarDrawerIngreso() {
        const drawer = document.getElementById('drawer-nuevo-ingreso');
        const overlay = document.getElementById('drawer-overlay-ingreso');
        const inputIdOculto = document.getElementById('input-id-cliente-oculto');
        const titulo = document.getElementById('titulo-drawer-ingreso');

        if (drawer && overlay) {
            drawer.classList.remove('open');
            overlay.classList.remove('open');
        }

        // 🛡️ LIMPIEZA DE RESETEO SAAS: Al cerrar, vaciamos el ID oculto y restauramos el título base
        // para que si después tocan el botón superior, nazca como cliente nuevo desde cero
        if (inputIdOculto) inputIdOculto.value = '';
        if (titulo) titulo.innerText = "📋 Registrar Nuevo Ingreso";
    }

    document.addEventListener('DOMContentLoaded', () => {
    // Escuchadores del botón general de la barra superior (Para ingresos desde cero)
    const btnToggleRegistro = document.getElementById('btn-toggle-registro');
    const btnCerrarIngreso = document.getElementById('btn-cerrar-drawer-ingreso');
    const overlayIngreso = document.getElementById('drawer-overlay-ingreso');

    // 🚀 CONTROL DE APERTURA PARA CLIENTES NUEVOS DESDE CERO
    if (btnToggleRegistro) {
        btnToggleRegistro.addEventListener('click', () => {
            // 🛡️ RESETEO GENERAL DE RESIDUOS MULTITENANT:
            // Vaciamos el ID oculto para que el backend reconozca que es un cliente NUEVO y no lo duplique
            const inputIdOculto = document.getElementById('input-id-cliente-oculto');
            if (inputIdOculto) inputIdOculto.value = '';

            // Limpiamos las cajas de texto de contacto
            const inputNombre = document.getElementById('input-nombre');
            const inputTelefono = document.getElementById('input-telefono');
            if (inputNombre) inputNombre.value = '';
            if (inputTelefono) inputTelefono.value = '';

            // Limpiamos los casilleros del servicio técnico
            const inputEquipo = document.getElementById('input-equipo');
            const inputFalla = document.getElementById('input-falla');
            if (inputEquipo) inputEquipo.value = '';
            if (inputFalla) inputFalla.value = '';

            // Restauramos el título base del encabezado del Drawer
            const titulo = document.getElementById('titulo-drawer-ingreso');
            if (titulo) titulo.innerText = "📋 Registrar Nuevo Ingreso";

            // Una vez que el formulario quedó inmaculado, forzamos su despliegue responsivo
            abrirDrawerIngreso();
        });
    }

    if (btnCerrarIngreso) btnCerrarIngreso.addEventListener('click', cerrarDrawerIngreso);
    if (overlayIngreso) overlayIngreso.addEventListener('click', cerrarDrawerIngreso);
});

// 🧠 FUNCIÓN DE INYECCIÓN DE PERTENENCIA MULTITENANT (CLIENTES EXISTENTES)
function prepararNuevoTicket(id, nombre, telefono) {
    // 1. Forzamos la apertura física del Drawer lateral deslizante reutilizable
    abrirDrawerIngreso();

    // 2. Cambiamos el título en vivo para darle una experiencia premium al usuario
    const titulo = document.getElementById('titulo-drawer-ingreso');
    if (titulo) {
        titulo.innerText = "➕ Nuevo Ticket para " + nombre;
    }

    // 3. Seteamos el ID del cliente en el input oculto para evitar duplicaciones en Clever Cloud
    const inputIdOculto = document.getElementById('input-id-cliente-oculto');
    if (inputIdOculto) {
        inputIdOculto.value = id;
    }

    // 4. Autocompletamos de forma automática los campos de contacto del cliente
    const inputNombre = document.getElementById('input-nombre');
    const inputTelefono = document.getElementById('input-telefono');
    const inputEquipo = document.getElementById('input-equipo');
    const inputFalla = document.getElementById('input-falla');

    if (inputNombre) inputNombre.value = nombre;
    if (inputTelefono) inputTelefono.value = telefono;
    
    // Limpiamos los campos del servicio anterior para que no queden residuos
    if (inputEquipo) inputEquipo.value = '';
    if (inputFalla) inputFalla.value = '';
    
    // Posicionamos el cursor automáticamente en el casillero del dispositivo
    if (inputEquipo) inputEquipo.focus();

    // 🎨 EFECTO VISUAL: Parpadeo de confirmación en el formulario principal
    const formPrincipal = document.getElementById('form-registro-principal');
    if (formPrincipal) {
        formPrincipal.style.backgroundColor = '#e6fffa';
        formPrincipal.style.transition = 'background-color 0.4s';
        setTimeout(() => { 
            formPrincipal.style.backgroundColor = 'transparent'; 
        }, 1200);
    }
}


    // 🗑️ GESTIÓN DE SEGURIDAD: Confirmación de alertas SweetAlert2
    function confirmarEliminacion(idTicket) {
        console.log("Intentando eliminar el ticket ID:", idTicket);

        Swal.fire({
            title: '¿Estás completamente seguro?',
            text: "Esta acción borrará el ticket técnico de forma permanente de la base de datos.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Sí, borrar ticket',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                const formulario = document.getElementById('form-eliminar-' + idTicket);
                if (formulario) {
                    formulario.submit();
                } else {
                    console.error("No se encontró el formulario oculto para el ID:", idTicket);
                }
            }
        });
    }
</script>
</body>
</html>
