<!-- src/views/partials/header.ejs -->
<header class="cabecera-bienvenida-taller">
    <div class="bloque-saludo-usuario">
        <% if (typeof usuarioSesion !== 'undefined' && usuarioSesion) { %>
            <!-- CONTENEDOR FLEX DEL SALUDO + AVATAR REDONDO -->
            <div class="wrapper-perfil-header-flex">
                <!-- 📷 FOTO CIRCULAR FLOTANTE: Lee la imagen del usuario de la sesión actual -->
                <div class="contenedor-avatar-header-flotante">
                    <img src="/images/users/<%= usuarioSesion.foto || 'default-user.png' %>" alt="Foto de Perfil" class="img-avatar-header">
                </div>
                
                <div class="textos-saludo-header">
                    <h2>
                        👋 ¡Hola, <span><%= usuarioSesion.username %></span>!
                    </h2>
                    <small>
                        Rango activo: 
                        <span class="<%= usuarioSesion.rol === 'admin' ? 'badge-rol-admin' : 'badge-rol-tecnico' %>">
                            <%= usuarioSesion.rol === 'admin' ? '👑 Administrador' : '🛠️ Técnico Operativo' %>
                        </span>
                    </small>
                </div>
            </div>
        <% } else { %>
            <div class="wrapper-perfil-header-flex">
                <div class="contenedor-avatar-header-flotante">
                    <img src="/images/users/default-user.png" alt="Foto de Perfil" class="img-avatar-header">
                </div>
                <div class="textos-saludo-header">
                    <h2>👋 Bienvenido al Taller</h2>
                    <small class="txt-sesion-alerta">⚠️ Sesión remota no identificada</small>
                </div>
            </div>
        <% } %>
    </div>

    <a href="/users/logout" class="btn-cerrar-sesion">
        🚪 Cerrar Sesión
    </a>
</header>
