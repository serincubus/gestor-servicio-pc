<%- include('./partials/head.ejs') %>
<link rel='stylesheet' href='/stylesheets/style.css' />
<link rel='stylesheet' href='/stylesheets/hardware.css' />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<body>
  <div id="drawer-overlay" class="drawer-overlay"></div>
  <%- include('./partials/header.ejs') %>

  <div class="container" style="margin-top: 20px; height: auto !important; overflow: visible !important;">
    <div class="contenedor-acciones-flex cabecera-hardware">
        <h1>👑 Panel Maestro Global (SaaS)</h1>
        <div style="display: flex; gap: 10px;">
            <button type="button" id="btn-abrir-alta" class="btn-ux btn-ux-nuevo" style="padding: 10px 15px;">
                ➕ Registrar Nuevo Comercio
            </button>
            <a href="/" class="btn-ux btn-ux-editar" style="padding: 10px 15px;">⬅️ Volver al Tablero</a>
        </div>
    </div>

    <!-- Buscador de Comercios -->
    <form action="/saas/panel" method="GET" class="form-busqueda">
        <input type="text" name="q" placeholder="🔍 Buscar comercio suscrito por nombre..." class="input-busqueda" value="<%= busqueda %>">
        <button type="submit" class="btn-buscar">Buscar</button>
        <a href="/saas/panel" class="btn-link-cancelar">Limpiar</a>
    </form>

    <div class="contenedor-usuarios-crud" style="margin-top: 20px;">
        
        <!-- DRAWER DESLIZANTE DE ALTA DE TALLERES -->
        <div class="bloque-formulario hardware-drawer" id="hardware-drawer">
            <div class="drawer-header">
                <h3>➕ Dar de Alta Nuevo Comercio</h3>
                <button type="button" class="btn-cerrar-drawer" id="btn-cerrar-drawer">✕</button>
            </div>
            
            <form action="/saas/comercios/guardar" method="POST" class="form-usuarios-input" style="display: flex; flex-direction: column; gap: 12px;">
                <label>Nombre del Comercio / Taller:</label>
                <input type="text" name="nombre_taller" placeholder="Ej: FixMobile San Miguel" required>
                
                <label>Teléfono de Contacto (Internacional):</label>
                <input type="text" name="telefono_contacto" placeholder="Ej: 5491100000000" required>
                
                <label>Dirección Física del Local:</label>
                <input type="text" name="direccion_fisica" placeholder="Ej: Av. Mitre 1234">
                
                <label>Identificación Legal / CUIT:</label>
                <input type="text" name="cuit_o_id_legal" placeholder="Ej: 30-12345678-9">

                <button type="submit" class="btn-guardar-completo btn-registrar-hardware" style="margin-top: 15px;">
                    Crear Base y Activar SaaS →
                </button>
            </form>
        </div>

        <!-- LISTADO DE CLIENTES SUSCRITOS -->
        <div class="bloque-tabla-usuarios" style="width: 100%;">
            <h3>Comercios con Licencia Activa</h3>
            <table class="tabla-hardware">
                <thead>
                    <tr>
                        <th style="width: 60px; text-align: center;">ID</th>
                        <th>Nombre del Establecimiento</th>
                        <th>Contacto</th>
                        <th>Dirección</th>
                        <th style="width: 120px; text-align: center;">Estado SaaS</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(comercios.length > 0) { %>
                        <% comercios.forEach(comercio => { %>
                            <tr>
                                <td style="text-align: center; font-family: monospace; font-weight: bold; color: #4a5568;"><%= comercio.id_comercio %></td>
                                <td><strong><%= comercio.nombre_taller %></strong></td>
                                <td style="font-size: 13.5px; color: #4a5568;"><%= comercio.telefono_contacto %></td>
                                <td style="font-size: 13.5px; color: #718096;"><%= comercio.direccion_fisica || 'No declarada' %></td>
                                <td style="text-align: center;">
                                    <span class="<%= comercio.activo ? 'badge-rol-admin' : 'card-deshabilitada' %>" style="padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;">
                                        <%= comercio.activo ? '🟢 Activo' : '🔴 Suspendido' %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; color: #999; padding: 25px;">No se encontraron comercios registrados.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const drawer = document.getElementById('hardware-drawer');
      const overlay = document.getElementById('drawer-overlay');
      const btnAbrirAlta = document.getElementById('btn-abrir-alta');
      const btnCerrar = document.getElementById('btn-cerrar-drawer');

      if(btnAbrirAlta) btnAbrirAlta.addEventListener('click', () => { drawer.classList.add('open'); overlay.classList.add('open'); });
      if(btnCerrar) btnCerrar.addEventListener('click', () => { drawer.classList.remove('open'); overlay.classList.remove('open'); });
      if(overlay) overlay.addEventListener('click', () => { drawer.classList.remove('open'); overlay.classList.remove('open'); });
    });
  </script>
</body>
</html>
